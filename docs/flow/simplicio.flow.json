{
  "schema": "simplicio.flow/v1",
  "id": "simplicio",
  "title": "Simplicio — entrada → passos → saídas",
  "version": "3.10.0",
  "nodes": [
    { "id": "in-installer", "kind": "input", "label": "Instalador assinado (sh/ps1)", "source": "install.sh" },
    { "id": "in-pypi", "kind": "input", "label": "Bootstrap PyPI (simplicio-installer)", "source": "pypi/simplicio/pyproject.toml" },
    { "id": "in-npm", "kind": "input", "label": "Pacote npm @simpletibr/simplicio", "source": "npm/simplicio/package.json" },
    { "id": "in-cli", "kind": "input", "label": "CLI simplicio", "source": "npm/simplicio/install.js" },
    { "id": "in-mcp", "kind": "input", "label": "Cliente MCP / host", "source": "plugins/simplicio/mcp.json" },
    { "id": "in-desktop", "kind": "input", "label": "Desktop / Tauri IPC", "source": "apps/desktop/src/bridge.ts" },
    { "id": "in-host-hook", "kind": "input", "label": "Hook do host (mapper/context)", "source": "plugins/simplicio/hooks/mapper_context.py" },
    { "id": "in-repo", "kind": "input", "label": "Automação de repositório e release", "source": "scripts/repository_policy.py" },
    { "id": "step-install", "kind": "step", "label": "Instala binário gerenciado + verifica assinatura", "source": "scripts/verify_ed25519.py", "command": "simplicio install" },
    { "id": "step-release", "kind": "step", "label": "Release local assinado", "source": "scripts/publish_release_local.py", "command": "python3 scripts/publish_release_local.py" },
    { "id": "step-version", "kind": "step", "label": "Verifica versão e integridade da instalação", "source": "VERSION.md", "command": "simplicio version" },
    { "id": "step-onboard", "kind": "step", "label": "Onboarding e indexação inicial", "source": "README.md", "command": "simplicio onboard" },
    { "id": "step-auth", "kind": "step", "label": "Login e sessão da conta", "source": "docs/HOST_INTEGRATIONS.md", "command": "simplicio auth" },
    { "id": "step-register-hosts", "kind": "step", "label": "Registra hosts, plugins e rotas", "source": "plugins/simplicio/host-surfaces.json", "command": "simplicio mcp" },
    { "id": "step-serve", "kind": "step", "label": "Serve MCP governado (stdio)", "source": "plugins/simplicio/.mcp.json", "command": "simplicio serve" },
    { "id": "step-bootstrap", "kind": "step", "label": "Bootstrap e preparação do Runtime", "source": "apps/desktop/src-tauri/src/runtime_process.rs" },
    { "id": "step-gate", "kind": "step", "label": "Gate de missão e efeito", "source": "plugin/hooks/action_gate.py", "tool": "simplicio_gate" },
    { "id": "step-map", "kind": "step", "label": "Map estrutural do repositório", "source": "apps/desktop/src/catalog_ui.ts", "command": "simplicio map", "tool": "simplicio_map" },
    { "id": "step-symbol", "kind": "step", "label": "Navegação de símbolos e declarações", "source": "apps/desktop/src/capability_registry.ts", "tool": "simplicio_symbol" },
    { "id": "step-search", "kind": "step", "label": "Busca estrutural e semântica", "source": "apps/desktop/src/omnisearch_projection.ts", "tool": "simplicio_search" },
    { "id": "step-read", "kind": "step", "label": "Leitura compacta de arquivos", "source": "apps/desktop/src/library_projection.ts", "tool": "simplicio_read" },
    { "id": "step-memory", "kind": "step", "label": "Memória indexada do projeto", "source": "apps/desktop/src/runtime_preparation.ts", "command": "simplicio memory", "tool": "simplicio_memory" },
    { "id": "step-context", "kind": "step", "label": "Contexto limitado por orçamento de tokens", "source": "apps/desktop/src/context_report.ts", "command": "simplicio context", "tool": "simplicio_context" },
    { "id": "step-edit", "kind": "step", "label": "Edição determinística com pré-imagem SHA-256", "source": "apps/desktop/src/execution_report.ts", "command": "simplicio edit", "tool": "simplicio_edit" },
    { "id": "step-validate", "kind": "step", "label": "Validação orientada a contrato", "source": "scripts/quality_policy.py", "tool": "simplicio_validate" },
    { "id": "step-run", "kind": "step", "label": "Execução governada de tarefa", "source": "apps/desktop/src/automation_projection.ts", "command": "simplicio run", "tool": "simplicio_run" },
    { "id": "step-exec", "kind": "step", "label": "Comandos externos supervisionados", "source": "apps/desktop/src/runtime_lifecycle.ts", "tool": "simplicio_exec" },
    { "id": "step-loop", "kind": "step", "label": "Loop e waves DAG com concorrência governada", "source": "plugin/hooks/loop_stop.py", "command": "simplicio loop" },
    { "id": "step-session", "kind": "step", "label": "Sessão: idle, uso e limites", "source": "apps/desktop/src/session_idle.ts" },
    { "id": "step-meter", "kind": "step", "label": "Cache meter medido", "source": "apps/desktop/src/cache_meter.ts" },
    { "id": "step-flowgen", "kind": "step", "label": "Geração determinística do fluxo", "source": "scripts/generate_flow.py", "command": "python3 scripts/generate_flow.py" },
    { "id": "step-flowverify", "kind": "step", "label": "Gate de drift e verificação do Langflow", "source": "scripts/verify_flow_langflow.py", "command": "python3 scripts/verify_flow_langflow.py" },
    { "id": "out-manifest", "kind": "output", "label": "Manifesto e checksums de atualização", "source": "simplicio-update-manifest.json" },
    { "id": "out-release", "kind": "output", "label": "Binários assinados e SHA256SUMS", "source": "SHA256SUMS" },
    { "id": "out-mcp-surface", "kind": "output", "label": "Superfície MCP anunciada (tools/list)", "source": "MCP-CONNECT.md" },
    { "id": "out-desktop", "kind": "output", "label": "Snapshots e projeções do Desktop", "source": "apps/desktop/src/activity_replay.ts" },
    { "id": "out-receipts", "kind": "output", "label": "Recibos de execução e auditoria", "source": "apps/desktop/src/execution_report.ts" },
    { "id": "out-tokens", "kind": "output", "label": "Relatório de tokens e economia", "source": "apps/desktop/src/token_report.ts" },
    { "id": "out-flow", "kind": "output", "label": "Diagramas Mermaid/SVG/Langflow do fluxo", "artifact": "docs/flow/simplicio.mmd" }
  ],
